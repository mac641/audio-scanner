{
  "compilerOptions": {
    "checkJs": true,
    "lib": [
      "dom",
      "deno.ns"
    ]
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.17",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/path": "jsr:@std/path@^1.1.6",
    "music-metadata": "npm:music-metadata@^11.16.0"
  },
  "lint": {
    "include": [
      "*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "always"
  },
  "lock": true,
  "nodeModulesDir": "auto",
  "exclude": [
    "bin/"
  ]
}
